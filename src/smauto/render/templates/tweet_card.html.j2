<!doctype html>
<html lang="{{ lang or 'tr' }}">
<head>
<meta charset="utf-8">
<style>
{{ font_faces }}

:root {
  --font-stack: {{ font_stack }};
  --bg: {{ c.bg }};
  --fg: {{ c.fg }};
  --muted: {{ c.muted }};
  --accent: {{ c.accent }};
  --border: {{ c.border }};
  --quote-bg: {{ c.quote_bg }};
  --shadow: {{ c.shadow }};
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  background: transparent;
  font-family: var(--font-stack);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body { padding: 24px; }

.card {
  width: {{ card_width }}px;
  background: var(--bg);
  color: var(--fg);
  border-radius: 32px;
  padding: 44px 48px 38px;
  box-shadow: 0 18px 48px var(--shadow);
  border: 1px solid var(--border);
}

.head { display: flex; align-items: center; gap: 20px; }

.avatar {
  width: 96px; height: 96px;
  border-radius: 50%;
  flex: 0 0 96px;
  object-fit: cover;
  background: var(--quote-bg);
}

.avatar-fallback {
  display: flex; align-items: center; justify-content: center;
  font-size: 44px; font-weight: 700; color: var(--fg);
  background: linear-gradient(135deg, {{ c.avatar_a }}, {{ c.avatar_b }});
}

.names { display: flex; flex-direction: column; min-width: 0; gap: 2px; }

.name {
  display: flex; align-items: center; gap: 8px;
  font-size: 38px; font-weight: 700; line-height: 1.2;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.badge { flex: 0 0 auto; width: 34px; height: 34px; }
.handle { font-size: 32px; color: var(--muted); line-height: 1.2; }

.text {
  margin-top: 30px;
  font-size: {{ font_size }}px;
  line-height: 1.36;
  white-space: pre-wrap;
  word-break: break-word;
  letter-spacing: -0.01em;
}

.text .ent { color: var(--accent); }

.foot {
  margin-top: 32px;
  padding-top: 22px;
  border-top: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  font-size: 27px; color: var(--muted);
}
.foot .logo { width: 30px; height: 30px; opacity: .85; }
</style>
</head>
<body>
<div class="card" id="card">
  <div class="head">
    {% if avatar_src %}
      <img class="avatar" src="{{ avatar_src }}" alt="">
    {% else %}
      <div class="avatar avatar-fallback">{{ initial }}</div>
    {% endif %}
    <div class="names">
      <div class="name">
        <span>{{ author_name }}</span>
        {% if verified %}
        <svg class="badge" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="{{ c.accent }}" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81C14.67 2.63 13.43 1.75 12 1.75s-2.67.88-3.34 2.19c-1.39-.46-2.9-.2-3.91.81s-1.27 2.52-.81 3.91C2.63 9.33 1.75 10.57 1.75 12s.88 2.67 2.19 3.34c-.46 1.39-.2 2.9.81 3.91s2.52 1.27 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.67-.88 3.34-2.19c1.39.46 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"></path>
        </svg>
        {% endif %}
      </div>
      <div class="handle">@{{ author_handle }}</div>
    </div>
  </div>

  {% if text_html %}<div class="text">{{ text_html }}</div>{% endif %}

  <div class="foot">
    <span>{{ timestamp }}</span>
    <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="{{ c.muted }}" d="M18.9 1.2h3.7l-8.1 9.2 9.5 12.6h-7.4l-5.8-7.6-6.7 7.6H.4l8.6-9.9L0 1.2h7.6l5.2 6.9 6.1-6.9zm-1.3 19.6h2L6.5 3.3H4.4l13.2 17.5z"></path>
    </svg>
  </div>
</div>
</body>
</html>
