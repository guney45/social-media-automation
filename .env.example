# Copy to .env and fill in. Never commit .env — `smauto doctor` checks for that.

# ─── Core ──────────────────────────────────────────────────────────────
ENV=dev                                   # dev | prod
DATABASE_URL=sqlite:///./data/smauto.db   # or a Postgres URL
DATA_DIR=./data
LOG_LEVEL=INFO

# ─── Telegram (required) ───────────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric user id from @userinfobot. Comma-separated for several people.
# Must not be empty: it is the only thing stopping a leaked token from being
# used to post on your behalf.
TELEGRAM_ALLOWED_USER_IDS=
# Where system notifications go. Usually the same as your user id.
TELEGRAM_TARGET_CHAT_ID=

# ─── AI (caption + content screening) ──────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_ENABLED=true
# Below this funny score, an item is rejected.
AI_MIN_SCORE=45

# ─── Render ────────────────────────────────────────────────────────────
CARD_THEME=dark                           # dark | light
RENDER_REEL=true
RENDER_FEED=true
RENDER_STORY=false

# ─── Delivery ──────────────────────────────────────────────────────────
# telegram  → finished files land in your chat, you post them yourself
# instagram → published automatically (needs IG_* and R2_* below)
DELIVERY_MODE=telegram
AUTO_PUBLISH=false

# ─── Instagram (only when DELIVERY_MODE=instagram) ─────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=

# ─── Storage (Instagram needs a public media URL) ──────────────────────
STORAGE_BACKEND=local                     # local | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ─── Scheduling ────────────────────────────────────────────────────────
TIMEZONE=Europe/Istanbul
PUBLISH_SLOTS=12:30,18:30,21:30
MAX_PER_DAY=3

# ─── Resilience ────────────────────────────────────────────────────────
MAX_ATTEMPTS=3
RESOLVER_CHAIN=fxtwitter,ytdlp,gallerydl,manual
HTTP_TIMEOUT_SECONDS=30
# Netscape cookies.txt, for posts yt-dlp/gallery-dl cannot see logged out.
# COOKIES_FILE=./data/cookies.txt

# ─── X API (optional, not used by default) ─────────────────────────────
X_API_ENABLED=false
X_BEARER_TOKEN=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_POLL_SOURCE=likes                       # likes | bookmarks

# ─── Misc ──────────────────────────────────────────────────────────────
# Fernet key, used to encrypt tokens when the database is not local.
TOKEN_ENCRYPTION_KEY=
# Override Chromium discovery if Playwright cannot find a browser.
# SMAUTO_CHROMIUM_PATH=
